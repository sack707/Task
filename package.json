{
  "name": "team-task-manager-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build": "pnpm db:generate && pnpm --recursive run build",
    "start:api": "pnpm --filter api start:prod",
    "start:web": "pnpm --filter web start",
    "start": "pnpm --filter api db:push && pnpm --filter api db:seed && pnpm --filter api start:prod",
    "db:generate": "pnpm --filter api db:generate",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}